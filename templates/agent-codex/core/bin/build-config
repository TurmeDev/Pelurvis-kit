#!/usr/bin/env python3
"""Builds ~/.codex/config.toml by joining core/codex.toml with modules/*/codex.toml.

Like build-agents with AGENTS.md: the base belongs to the core and each module adds its
block (a module's keys override the base's). From the previous configuration it keeps
only what Codex writes: the hook approval ([hooks.state]) and [tui].
Run by the administrator after adding or removing a module; not by the agent.
"""
import json
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
DEST = Path.home() / ".codex/config.toml"
KEEP = ("hooks", "tui")


def merge(a, b):
    for k, v in b.items():
        if isinstance(v, dict) and isinstance(a.get(k), dict):
            merge(a[k], v)
        else:
            a[k] = v
    return a


def key(k):
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)


def value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{key(k)} = {value(x)}" for k, x in v.items()) + " }"
    raise TypeError(f"unsupported type: {type(v)}")


def write(d, path=(), out=None):
    out = [] if out is None else out
    simple = {k: v for k, v in d.items() if not isinstance(v, dict)}
    tables = {k: v for k, v in d.items() if isinstance(v, dict)}
    if path and (simple or not tables):
        out.append("\n[" + ".".join(key(k) for k in path) + "]")
    for k, v in simple.items():
        out.append(f"{key(k)} = {value(v)}")
    for k, v in tables.items():
        write(v, path + (k,), out)
    return out


def main():
    base = tomllib.loads((ROOT / "core/codex.toml").read_text(encoding="utf-8"))
    used = []
    for file in sorted(ROOT.glob("modules/*/codex.toml")):
        text = file.read_text(encoding="utf-8").replace("__HOME__", str(Path.home()))
        merge(base, tomllib.loads(text))
        used.append(file.parent.name)
    if DEST.exists():
        previous = tomllib.loads(DEST.read_text(encoding="utf-8"))
        for k in KEEP:
            if k in previous:
                base[k] = merge(base.get(k, {}), previous[k])
    text = ("# Generated by core/bin/build-config from core/codex.toml"
            + (" and the modules: " + ", ".join(used) if used else "") + ".\n"
            "# Do not edit: change the layer and run it again.\n" + "\n".join(write(base)).lstrip("\n") + "\n")
    tomllib.loads(text)  # the generated output must be valid TOML before writing it
    DEST.parent.mkdir(parents=True, exist_ok=True)
    tmp = DEST.with_suffix(".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(DEST)
    print(f"{DEST}: base + {', '.join(used) or 'no modules'}")
    if "hooks" not in base or "state" not in base.get("hooks", {}):
        print("warning: the guard is not yet approved in Codex", file=sys.stderr)


if __name__ == "__main__":
    main()
