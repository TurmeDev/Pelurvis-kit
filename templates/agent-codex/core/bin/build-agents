#!/usr/bin/env bash
# Builds AGENTS.md by joining the layers, because Codex does not support imports:
# core, then the skin and then each module (in alphabetical order).
# It also links the modules' skills (modules/<m>/skills/<s>) into ~/.agents/skills.
# Not in ~/bot/.agents: Codex only sees them there if launched from ~/bot, and the bot runs from
# work/. ~/.agents is outside what the sandbox lets be written.
# Run by the administrator after changing any layer; not by the agent.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"
{
  echo "<!-- Generated by core/bin/build-agents. Do not edit: change the layer and run it again. -->"
  for f in core/CORE.md skin/identity.md skin/data.md modules/*/MODULE.md; do
    [[ -f "$f" ]] || continue
    echo
    cat "$f"
  done
} > AGENTS.md.new
mv AGENTS.md.new AGENTS.md
echo "AGENTS.md: $(wc -c < AGENTS.md) bytes (Codex limit: 32768)"

# Skills: only links to the modules' ones; always rebuilt (removing a module removes its skills).
skills="$HOME/.agents/skills"
rm -rf "$skills"
mkdir -p "$skills"
n=0
for s in modules/*/skills/*/; do
  [[ -f "$s/SKILL.md" ]] || continue
  name="$(basename "$s")"
  [[ -e "$skills/$name" ]] && { echo "duplicate skill: $name ($s)" >&2; exit 1; }
  ln -s "$root/${s%/}" "$skills/$name"
  n=$((n + 1))
done
echo "skills: $n ($(ls "$skills" | tr '\n' ' '))"
