#!/usr/bin/env bash
# Uploads to Notion a file received via Telegram (step 2 of notion-create-file-upload).
#
#   upload-notion <file> <upload_url> <token>
#
# It only accepts files from the Telegram channel inbox and only the Notion
# upload URL; <token> is the value of "authorization: Bearer <token>" from upload_headers.
# This way the agent does not need free-form curl, which could be used to send data anywhere.
set -euo pipefail
[[ $# -eq 3 ]] || { echo "usage: upload-notion <file> <upload_url> <token>" >&2; exit 2; }

inbox="$(realpath "$HOME/.claude/channels/telegram/inbox")"
file="$(realpath -e "$1" 2>/dev/null)" || { echo "error: $1 does not exist" >&2; exit 2; }
[[ "$file" == "$inbox"/* && -f "$file" ]] || { echo "error: only files from the Telegram inbox" >&2; exit 2; }
[[ "$2" =~ ^https://api\.notion\.com/v1/mcp/file_uploads/[0-9a-f-]{36}/send$ ]] || { echo "error: invalid upload URL" >&2; exit 2; }
# The token is standard or URL-safe base64: it may contain + / _ - = and dots. No spaces
# or quotes, and it is always quoted in the header.
[[ "$3" =~ ^[A-Za-z0-9._=+/-]{20,2000}$ ]] || { echo "error: invalid token" >&2; exit 2; }

curl -sS --fail-with-body --max-time 60 -X POST "$2" \
  -H "authorization: Bearer $3" \
  -F "file=@$file"
echo
